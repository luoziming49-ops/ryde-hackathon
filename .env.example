# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- LLM provider (OpenAI-compatible, e.g. Tencent Cloud Hunyuan) ---
# Base URL of the chat-completions endpoint (no trailing slash).
LLM_BASE_URL=https://api.openai.com/v1
# API key. Leave empty to run in deterministic fallback mode (no LLM).
LLM_API_KEY=
# Chat model name.
LLM_MODEL=gpt-4o-mini
# Optional vision model for image evidence (P9).
LLM_VISION_MODEL=

# Backward-compatible aliases (optional).
# OPENAI_BASE_URL=
# OPENAI_API_KEY=

# --- Server ---
PORT=8000
# Directory for the SQLite database (P6). Defaults to ./data.
DATA_DIR=./data
# Comma-separated allowed CORS origins (P10). Default: * for local dev.
ALLOWED_ORIGINS=*
