# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- DeepSeek official OpenAI-compatible API ---
# Base URL of the chat-completions endpoint (no trailing slash).
LLM_BASE_URL=https://api.deepseek.com
# API key. Leave empty to run in deterministic fallback mode (no LLM).
LLM_API_KEY=
# Chat model name.
LLM_MODEL=deepseek-flash
# Explicitly disable thinking and request JSON for structured agent calls.
LLM_THINKING=disabled
LLM_JSON_MODE=true
# Set true only when you intend to enable paid Live API runs.
LLM_LIVE_ENABLED=false
# Must exactly match the approved destination above (trailing slash ignored).
LLM_CONFIRMED_BASE_URL=https://api.deepseek.com

# Backward-compatible aliases take priority when set. Leave unset for DeepSeek.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=

# --- Server ---
PORT=8765
